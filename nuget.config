<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline-first restore for the handoff package.
  tools\nuget-local contains the exact nupkg files this project needs, so a machine
  without internet (and without the workspace NuGet cache) can restore and build.
  Delete this file (or add nuget.org back) when you want to restore from the internet.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="tools\nuget-local" />
  </packageSources>
</configuration>
